    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "prettier": "^2.2.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^8.0.0",
    "typescript": "^5.0.4",
    "vite": "^7.0.6",
    "webpack": "^5.76.0",
    "webpack-cli": "^4.0.0"
